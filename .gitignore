CHANGELOG.md
SESSIONLOG.md
staticfiles/
.env
# Basic Auth credentials for the production nginx (docker-compose.yml mounts
# it). Holds a password hash — belongs on the host, never in the repo.
.htpasswd

# Real SSH targets/paths for the deploy skill. Holds infrastructure details
# — belongs on the maintainer's machine, never in the repo.
.claude/skills/deploy/hosts.md
demo.sqlite3
# SQLite's own sidecars for the file above. They exist only while the demo
# stack is running, and `git add -A` after a local run sweeps them in
# otherwise — ignoring the database and not its two companions is half an
# ignore rule.
demo.sqlite3-shm
demo.sqlite3-wal
.venv/
__pycache__/
*.pyc

# Coverage run artefacts, regenerated by every test run.
.coverage
htmlcov/

.DS_Store
*.map
.env

# Only bootstrap.min.css is vendored (#64). These guard against an accidental
# full-dist unzip putting the unused builds back into the repo.
projects/static/projects/css/bootstrap-*
projects/static/projects/css/bootstrap.css
projects/static/projects/css/bootstrap.rtl*
projects/static/projects/js/bootstrap*
ANALYSEN.md

# Git worktrees created by `claude --worktree`. Each one is a full checkout of
# the repo: it belongs on the maintainer's machine, never in the repo.
.claude/worktrees/
.claude/settings.local.json
