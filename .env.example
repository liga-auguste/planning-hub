SECRET_KEY=insert-a-long-random-string-here
DEBUG=false
ALLOWED_HOSTS=192.168.x.x localhost

# Required only behind an HTTPS-terminating reverse proxy (the demo stack);
# production sits behind VPN over plain HTTP and leaves this empty.
CSRF_TRUSTED_ORIGINS=

# #157: secure cookies, HSTS and the HTTPS redirect. On by default whenever
# DEBUG is false, so a fresh deployment is secure without naming this at all.
# Set it to false only for a deployment that genuinely has no TLS — this
# production stack is one: nginx listens on port 80 and access is over VPN, so
# a Secure cookie would be discarded by the browser and take sessions and
# every POST with it.
#
# Order matters when switching an existing host: write this line before
# pulling and rebuilding, not after.
HTTPS_ONLY=false

NOTION_API_KEY=
ANTHROPIC_API_KEY=

DB_NAME=planning_hub
DB_USER=liga
DB_PASSWORD=choose-a-password-here
DB_HOST=db
DB_PORT=5432

DEMO_MODE=false
