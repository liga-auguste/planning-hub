<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the nightly production backup (#300). A template: the
  install step in docs/backup.md replaces __REPO__ with the checkout and
  __LOG__ with the log file, so no host path lives in the repository.
  A per-user agent, not a system daemon: it runs in the login session that
  Docker Desktop runs in, and a run missed during sleep starts on wake.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.ligaauguste.planninghub.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__REPO__/backup/backup.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
