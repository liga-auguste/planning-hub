# The public demo stack (docker-compose.demo.yml). Copy to .env and fill in
# the secret, the API key and your domain. Production uses
# .env.production.example instead.

SECRET_KEY=insert-a-long-random-string-here
DEBUG=false
ALLOWED_HOSTS=your-domain.example localhost

# The demo sits behind an HTTPS-terminating reverse proxy, which Django's CSRF
# check has to trust by origin.
CSRF_TRUSTED_ORIGINS=https://your-domain.example

ANTHROPIC_API_KEY=

DEMO_MODE=true

# #157: secure cookies, HSTS and the HTTPS redirect. On by default whenever
# DEBUG is false, which is what this TLS stack needs, so leave it unset.
# HTTPS_ONLY=true

# #192: how displayed dates are spelled. One of standard ("Mo, 3. März"),
# numeric ("Mo, 03.03.") or no_weekday ("3. März"); defaults to standard.
# The default only: a style chosen on /regeln/ overrides it.
# An unknown or empty value stops the server at startup rather than falling back.
DATE_STYLE=standard

# Read by entrypoint.sh; the values shown are the defaults.
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
